{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: SO (Debug)",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-g3",
                "-O0",
                "-std=c++17",
                "-I",
                "${workspaceFolder}/src",
                "${workspaceFolder}/src/main.cpp",
                "${workspaceFolder}/src/Archivos/fcb.cpp",
                "${workspaceFolder}/src/Archivos/filesystem.cpp",
                "${workspaceFolder}/src/Entrada_Salida/dispositivo.cpp",
                "${workspaceFolder}/src/Entrada_Salida/interrupciones.cpp",
                "${workspaceFolder}/src/Kernel/kernel.cpp",
                "${workspaceFolder}/src/Memoria/memoria.cpp",
                "${workspaceFolder}/src/Memoria/paginacion.cpp",
                "${workspaceFolder}/src/Procesos/pcb.cpp",
                "${workspaceFolder}/src/Procesos/scheduler.cpp",
                "-o",
                "${workspaceFolder}/build/Debug/SO.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "C:\\msys64\\ucrt64\\bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": "$gcc",
            "dependsOn": "Create build dir"
        },
        {
            "label": "Create build dir",
            "type": "shell",
            "command": "if not exist build\\Debug mkdir build\\Debug",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "cmd.exe",
                    "args": [
                        "/d",
                        "/c"
                    ]
                }
            },
            "presentation": {
                "reveal": "silent"
            },
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                ""
            ],
            "options": {
                "cwd": "C:\\msys64\\ucrt64\\bin"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}