{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build: SO (Debug)",
            "type": "shell",
            "command": "if (-not (Test-Path \"build\\Debug\")) { New-Item -Path \"build\\Debug\" -ItemType Directory | Out-Null }; & \"C:\\msys64\\ucrt64\\bin\\g++.exe\" -Wall -Wextra -g3 -O0 -std=c++17 -I \"${workspaceFolder}/src\" \"${workspaceFolder}/src/main.cpp\" \"${workspaceFolder}/src/Archivos/fcb.cpp\" \"${workspaceFolder}/src/Archivos/filesystem.cpp\" \"${workspaceFolder}/src/Entrada_Salida/dispositivo.cpp\" \"${workspaceFolder}/src/Entrada_Salida/interrupciones.cpp\" \"${workspaceFolder}/src/Kernel/kernel.cpp\" \"${workspaceFolder}/src/Memoria/memoria.cpp\" \"${workspaceFolder}/src/Memoria/paginacion.cpp\" \"${workspaceFolder}/src/Procesos/pcb.cpp\" \"${workspaceFolder}/src/Procesos/scheduler.cpp\" -o \"${workspaceFolder}/build/Debug/SO.exe\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-Command"
                        ]
                    }
                }
            },
            "linux": {
                "command": "make"
            },
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "C/C++: g++.exe build active file",
            "type": "shell",
            "command": "g++ -fdiagnostics-color=always -g \"${file}\" -o \"${fileDirname}\\${fileBasenameNoExtension}.exe\"",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "options": {
                    "shell": {
                        "executable": "powershell.exe",
                        "args": [
                            "-NoProfile",
                            "-ExecutionPolicy",
                            "Bypass",
                            "-Command"
                        ]
                    }
                }
            },
            "linux": {
                "command": "g++ -fdiagnostics-color=always -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\""
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        }
    ]
}